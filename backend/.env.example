# Server Configuration
PORT=5000

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/placementorai

# JWT Secret (Use a strong, randomly generated string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Frontend URL (for CORS and password reset links)
FRONTEND_URL=http://localhost:5500

# Node Environment
NODE_ENV=development

# Email (Nodemailer — used for password reset and application status emails)
# Use a Gmail account with an App Password (not your regular Gmail password).
# See: https://support.google.com/accounts/answer/185833
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-gmail-app-password
